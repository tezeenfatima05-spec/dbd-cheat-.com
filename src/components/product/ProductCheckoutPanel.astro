---
import type { ProductPage } from '../../data/products';
import Icon from '../icons/Icon.astro';
import ProductIconWell from './ProductIconWell.astro';
import { Button } from '@/components/starwind/button';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
const source = product.fullFeatures.length > 0 ? product.fullFeatures : product.features;
const listed = source.slice(0, 6);
---

<aside class="product-checkout text-left lg:sticky lg:top-24" aria-labelledby={`checkout-${product.slug}`}>
  <div class="overflow-hidden rounded-2xl border border-primary/35 bg-card shadow-md ring-1 ring-primary/15">
    <div class="card-title-band flex items-center justify-start gap-3 px-5 py-4 text-left">
      <ProductIconWell name="acqPackage" iconSize={20} class="bg-primary/15" />
      <div class="min-w-0 text-left">
        <h2 id={`checkout-${product.slug}`} class="text-base font-semibold leading-snug tracking-wide">
          PRODUCT FEATURES
        </h2>
        <p class="text-xs font-medium text-muted-foreground">Explore what's included</p>
      </div>
    </div>

    <div class="space-y-5 px-5 pb-5 pt-5">
      <ul class="space-y-2.5">
        {
          listed.map((feature) => (
            <li class="flex items-start gap-2.5 text-sm leading-snug text-foreground">
              <Icon name="check" size={14} class="mt-0.5 shrink-0 text-primary" />
              <span>{feature}</span>
            </li>
          ))
        }
      </ul>

      <Button
        as="a"
        href={product.buyUrl}
        rel="sponsored noopener nofollow"
        variant="primary"
        size="lg"
        class="w-full rounded-xl"
      >
        Proceed to Checkout →
      </Button>
    </div>
  </div>
</aside>
